<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Testes\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Driver de acesso ao MySQL (licença MIT). -->
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Script do banco copiado junto com o executável, para referência. -->
    <None Include="Banco\schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
